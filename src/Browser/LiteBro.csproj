<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10/11, so nothing else has to be installed -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>LiteBro</Product>
    <Company>ronanime-arch</Company>
    <Description>Лёгкий браузер для локальных проектов</Description>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="home.html" LogicalName="home.html" />
    <EmbeddedResource Include="net.html" LogicalName="net.html" />
    <EmbeddedResource Include="netpage.js" LogicalName="netpage.js" />
    <EmbeddedResource Include="storage.html" LogicalName="storage.html" />
    <EmbeddedResource Include="sitestorage.js" LogicalName="sitestorage.js" />
    <EmbeddedResource Include="jsonview.js" LogicalName="jsonview.js" />
    <EmbeddedResource Include="dev.html" LogicalName="dev.html" />
    <EmbeddedResource Include="term\index.html" LogicalName="term/index.html" />
    <EmbeddedResource Include="term\term.js" LogicalName="term/term.js" />
    <EmbeddedResource Include="term\xterm.js" LogicalName="term/xterm.js" />
    <EmbeddedResource Include="term\addon-fit.js" LogicalName="term/addon-fit.js" />
    <EmbeddedResource Include="term\xterm.css" LogicalName="term/xterm.css" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
