<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>LiteBrowser-Setup</AssemblyName>
    <RootNamespace>LiteBrowserSetup</RootNamespace>
    <ApplicationIcon>..\Browser\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.9.6</Version>
    <Product>LiteBrowser</Product>
    <Description>Установка LiteBrowser</Description>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Compile Include="..\Browser\Associations.cs" Link="Associations.cs" />
    <!-- build.ps1 zips the browser build into this file before building the installer -->
    <EmbeddedResource Include="..\..\build\payload.zip" LogicalName="payload.zip" />
    <EmbeddedResource Include="..\Browser\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
